<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Picklebook - Court Reservations</title>
  <script crossorigin src="https://unpkg.com/react@18/umd/react.production.min.js"></script>
  <script crossorigin src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js"></script>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; margin: 0; }
  </style>
</head>
<body>
  <div id="root"></div>
  <script>
    const React = window.React;
    const ReactDOM = window.ReactDOM;
    const { useState, useEffect } = React;
    const e = React.createElement;

    function App() {
      const [courts, setCourts] = useState([]);
      const [loading, setLoading] = useState(true);
      const [error, setError] = useState(null);

      useEffect(() => {
        fetch('https://picklebook-backend-production.up.railway.app/courts')
          .then(r => r.json())
          .then(data => {
            setCourts(Array.isArray(data) ? data : []);
            setLoading(false);
          })
          .catch(err => {
            console.error('Backend error:', err);
            setError('Could not load courts');
            setLoading(false);
          });
      }, []);

      return e('div', { className: 'min-h-screen bg-gray-50' },
        // Header
        e('div', { className: 'bg-gradient-to-r from-blue-600 to-blue-800 text-white py-12' },
          e('div', { className: 'max-w-7xl mx-auto px-4' },
            e('div', { className: 'flex items-center gap-3 mb-4' },
              e('div', { className: 'text-5xl' }, '🎾'),
              e('h1', { className: 'text-4xl font-bold' }, 'Picklebook')
            ),
            e('p', { className: 'text-lg text-blue-100' }, 'Find and book pickleball courts in Dumaguete')
          )
        ),

        // Main Content
        e('div', { className: 'max-w-7xl mx-auto px-4 py-12' },
          // Loading/Error
          loading && e('div', { className: 'text-center text-gray-600 text-lg' }, '⏳ Loading courts...'),
          error && e('div', { className: 'bg-red-50 border border-red-200 rounded-lg p-4 text-red-700 mb-8' }, error),

          // Courts Grid
          !loading && courts.length > 0 && e('div', { className: 'grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6' },
            courts.map((court, i) => 
              e('div', { key: i, className: 'bg-white rounded-lg shadow-md p-6 hover:shadow-lg transition-shadow' },
                // Court Image
                e('div', { className: 'bg-gradient-to-b from-blue-100 to-blue-50 h-40 rounded-lg mb-4 flex items-center justify-center text-5xl' }, '🎾'),
                
                // Court Name
                e('h3', { className: 'text-lg font-bold text-gray-800 mb-2' }, court.name || 'Court ' + (i+1)),
                
                // Location
                e('p', { className: 'text-gray-600 text-sm mb-4' }, court.location || '📍 Dumaguete, Philippines'),
                
                // Price & Available
                e('div', { className: 'flex justify-between items-center' },
                  e('span', { className: 'text-2xl font-bold text-blue-600' }, '₱' + (court.pricePerHour || '100') + '/hr'),
                  e('span', { className: 'text-xs bg-green-100 text-green-800 px-3 py-1 rounded font-semibold' }, (court.availableCourts || '4') + ' courts')
                ),

                // Book Button
                e('button', { 
                  className: 'w-full mt-4 bg-blue-600 text-white py-2 rounded-lg hover:bg-blue-700 font-semibold transition',
                  onClick: () => alert('Login required to book. Backend: ' + 'https://picklebook-backend-production.up.railway.app')
                }, 'Book Now')
              )
            )
          ),

          // No Courts
          !loading && courts.length === 0 && e('div', { className: 'text-center py-12' },
            e('div', { className: 'text-6xl mb-4' }, '🎾'),
            e('h2', { className: 'text-2xl font-bold text-gray-800 mb-2' }, 'No courts available yet'),
            e('p', { className: 'text-gray-600 mb-4' }, 'Backend is loading... Refresh the page in a moment.'),
            e('button', { 
              className: 'bg-blue-600 text-white px-6 py-2 rounded-lg hover:bg-blue-700',
              onClick: () => window.location.reload()
            }, 'Refresh')
          )
        ),

        // Footer
        e('div', { className: 'bg-gray-800 text-gray-400 py-8 text-center' },
          e('p', {}, '© 2026 Picklebook - Pickleball Court Reservations'),
          e('p', { className: 'text-sm mt-2' }, '🌐 Backend: picklebook-backend-production.up.railway.app')
        )
      );
    }

    ReactDOM.createRoot(document.getElementById('root')).render(e(App));
  </script>
</body>
</html>
